{% extends 'base.html.twig' %}

{% block title %}
	{% if payment_info and payment_info.is_failed %}
		Betaling mislukt - Il Grigio
	{% else %}
		Bedankt voor je bestelling - Il Grigio
	{% endif %}
{% endblock %}

{% block body %}
	<header class="bg-[#c62828] text-white border-b-8 border-[#a91f24]">
		<div class="px-4 py-3 flex items-center justify-between gap-6 max-w-6xl mx-auto">
			<a href="{{ path('app_tickets') }}" aria-label="Jeugdcircus Il Grigio" class="shrink-0 flex items-center gap-3">
				<img src="{{ asset('images/Logo-IlGrigioClown.png') }}" alt="Jeugdcircus Il Grigio" class="h-10 md:h-12 w-auto">
				<span class="text-white font-bold tracking-wider md:text-base sm:text-sm">Jeugdcircus Il Grigio</span>
			</a>
			{% include 'customer/_header_link.html.twig' %}
		</div>
	</header>
	<section class="bg-[#fff1df] border-b border-[#eadfd1] text-center px-5 py-10 md:py-14">
		{% if payment_info and payment_info.is_failed %}
			<h1 class="font-stopbuck text-4xl md:text-6xl text-[#c62828]">Betaling mislukt</h1>
		{% else %}
			<h1 class="font-stopbuck text-4xl md:text-6xl text-[#c62828]">Bedankt voor je reservering!</h1>
		{% endif %}
	</section>

	<section class="bg-[#fffaf2] min-h-[60vh] px-4 py-8 md:py-12">
		<div class="max-w-6xl mx-auto bg-white border border-[#eadfd1] shadow-lg p-6 md:p-10 text-center">
			<div class="mb-5" aria-hidden="true">
				{% if payment_info and payment_info.is_failed %}
					<i class="fas fa-circle-xmark text-red-600 text-6xl"></i>
				{% else %}
					<i class="fas fa-circle-check text-green-600 text-6xl"></i>
				{% endif %}
			</div>

			{% if order_id %}
				{% if payment_info and payment_info.is_failed %}
					<p class="text-lg md:text-xl text-[#3d3535] mb-5">Je betaling kon helaas niet worden verwerkt.</p>
				{% elseif payment_info and payment_info.is_pending %}
					<p class="text-lg md:text-xl text-[#3d3535] mb-5">Je betaling wordt verwerkt. Dit kan enkele minuten duren.</p>
				{% else %}
					<p class="text-lg md:text-xl text-[#3d3535] mb-5">Je reservering is succesvol geplaatst.</p>
				{% endif %}

				<div class="inline-block bg-[#fff1df] border border-[#eadfd1] px-5 py-3 mb-8 text-[#34272a]">
					<strong>Reserveringsnummer:</strong> #{{ order_id }}
				</div>

				{% if payment_info %}
					<div class="mb-8 border-y border-[#eadfd1] py-4">
						{% if payment_info.is_successful %}
							<p class="font-semibold text-green-700"><i class="fas fa-circle-check mr-2" aria-hidden="true"></i>{{ payment_info.status_message }}</p>
						{% elseif payment_info.is_pending %}
							<p class="font-semibold text-amber-700"><i class="fas fa-clock mr-2" aria-hidden="true"></i>{{ payment_info.status_message }}</p>
						{% elseif payment_info.is_failed %}
							<p class="font-semibold text-red-700"><i class="fas fa-circle-xmark mr-2" aria-hidden="true"></i>{{ payment_info.status_message }}</p>
						{% endif %}
					</div>
				{% endif %}
			{% else %}
				<p class="text-lg md:text-xl text-[#3d3535] mb-8">Je reservering wordt verwerkt.</p>
			{% endif %}

			{% if payment_info and payment_info.is_failed %}
				<div class="mb-8 bg-[#fff1df] border-l-4 border-[#c62828] p-6 text-left">
					<h2 class="text-xl font-bold text-[#34272a] mb-2">Wat kan je doen?</h2>
					<p class="text-[#3d3535]">Je kunt het opnieuw proberen door terug te gaan naar de shows en een nieuwe reservering te maken. Als het probleem zich blijft voordoen, controleer dan je betaalmethode of neem contact met ons op.</p>
				</div>
			{% else %}
				<h2 class="text-xl font-bold text-[#34272a] mb-5">Wat gebeurt er nu?</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
					<div class="bg-[#fff7eb] border border-[#eadfd1] p-5">
						<i class="fas fa-credit-card text-amber-600 text-3xl mb-3" aria-hidden="true"></i>
						<p class="text-sm font-medium text-[#3d3535]">
							{% if payment_info and payment_info.is_successful %}Je betaling is voltooid{% else %}Je betaling wordt verwerkt{% endif %}
						</p>
					</div>
					<div class="bg-[#fff7eb] border border-[#eadfd1] p-5">
						<i class="fas fa-envelope text-blue-600 text-3xl mb-3" aria-hidden="true"></i>
						<p class="text-sm font-medium text-[#3d3535]">
							Je ontvangt een bevestigingsmail{% if customer_data and customer_data.email %} op <strong>{{ customer_data.email }}</strong>{% endif %}
						</p>
					</div>
					<div class="bg-[#fff7eb] border border-[#eadfd1] p-5">
						<i class="fas fa-ticket text-[#c62828] text-3xl mb-3" aria-hidden="true"></i>
						<p class="text-sm font-medium text-[#3d3535]">Je tickets worden toegestuurd via de mail</p>
					</div>
				</div>

				<div class="bg-white border-l-4 border-[#c62828] shadow-md p-6 mb-8 text-left">
					<h3 class="font-bold text-[#a91f24] mb-2"><i class="fas fa-triangle-exclamation mr-2" aria-hidden="true"></i>Geen mail ontvangen?</h3>
					<p class="text-[#3d3535]">Controleer eerst je spam- of ongewenste map. Vergeet niet je e-tickets te downloaden. Kom je er niet uit? Mail ons dan op <a href="mailto:reserveringen@ilgrigio.nl" class="font-semibold text-[#b91c1c] underline underline-offset-2">reserveringen@ilgrigio.nl</a>.</p>
				</div>
			{% endif %}

			<a href="{{ path('app_tickets') }}" class="inline-flex items-center justify-center gap-3 bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold px-6 py-4 transition-colors">
				<i class="fas {% if payment_info and payment_info.is_failed %}fa-redo{% else %}fa-arrow-left{% endif %}" aria-hidden="true"></i>
				{% if payment_info and payment_info.is_failed %}Probeer opnieuw{% else %}Terug naar shows{% endif %}
			</a>
		</div>
	</section>
{% endblock %}
