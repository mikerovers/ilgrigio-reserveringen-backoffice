{% extends 'base.html.twig' %}

{% from 'components/macros.html.twig' import dutch_date %}

{% block title %}Voorstellingen & tickets | Jeugdcircus Il Grigio{% endblock %}

{% block body %}
	<header class="bg-[#c62828] text-white border-b-8 border-[#a91f24]">
		<div class="px-4 py-3 flex items-center justify-between gap-6 max-w-6xl mx-auto">
			<a href="{{ path('app_tickets') }}" aria-label="Jeugdcircus Il Grigio" class="shrink-0 flex items-center gap-3">
				<img src="{{ asset('images/Logo-IlGrigioClown.png') }}" alt="Jeugdcircus Il Grigio" class="h-10 md:h-12 w-auto">
				<span class="text-white font-bold tracking-wider md:text-base sm:text-sm">Jeugdcircus Il Grigio</span>
			</a>
			{% include 'customer/_header_link.html.twig' %}
		</div>
	</header>

	<main class="bg-[#fffaf2] min-h-screen">
		{% set show_homepage_hero = homepage and (homepage.heroTitle|trim or homepage.heroDateText|trim or homepage.heroDescription|trim) %}
		{% if show_homepage_hero %}
			<section class="bg-[#fff1df] border-b border-[#eadfd1]" aria-label="Showinformatie">
				<div class="container mx-auto px-5 py-12 md:py-16 max-w-6xl">
					<div class="max-w-4xl">
						<p class="text-sm font-bold uppercase tracking-[.18em] text-black mb-3">Jeugdcircus Il Grigio presenteert</p>
						{% if homepage.heroTitle|trim %}<h1 id="show-title" class="font-stopbuck text-5xl md:text-7xl leading-[1.05] text-[#c62828]">{{ homepage.heroTitle }}</h1>{% endif %}
						{% if homepage.heroDateText|trim %}<p class="mt-4 text-xl md:text-2xl font-semibold text-black">{{ homepage.heroDateText }}</p>{% endif %}
						{% if homepage.heroDescription|trim %}<p class="mt-6 max-w-3xl text-lg leading-relaxed text-black">{{ homepage.heroDescription }}</p>{% endif %}
						<a href="#performance-dates" class="mt-8 inline-flex items-center gap-3 bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold px-6 py-4 transition-colors">Bekijk tickets <span aria-hidden="true">↓</span></a>
					</div>
				</div>
			</section>
		{% endif %}

		{% if events %}
			<section class="container mx-auto px-4 py-10 md:py-12 pb-12 max-w-6xl" aria-labelledby="performance-dates">
				<h2 id="performance-dates" class="font-serif text-3xl text-[#34272a] mb-2">Kies een voorstelling</h2>
				<p class="text-gray-700 mb-6">Kies een datum en tijd om tickets voor Biblio Magico! te reserveren.</p>
				<div class="divide-y divide-[#eadfd1] border-y border-[#eadfd1] bg-white">
					{% for event in events %}
						{% set in_stock = event.stock_status == 'instock' and (event.stock_quantity is null or event.stock_quantity > 0) %}
						<div class="p-5 md:px-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
							<div>
								<p class="text-lg font-bold text-[#34272a]">{{ event.date ? dutch_date(event.date) : 'events.date_tbd'|trans }}{% if event.description|default('')|trim %} <span class="font-normal text-gray-600">- {{ event.description }}</span>{% endif %}</p>
								<p class="text-gray-700">{% if event.doors_open %}{{ 'events.doors_open'|trans }} {{ event.doors_open }} <span class="text-gray-400">·</span> {% endif %}{% if event.time %}{{ 'events.show_start'|trans }} {{ event.time }} uur{% endif %}{% if event.location %} <span class="text-gray-400">·</span> {{ event.location }}{% endif %}</p>
							</div>
							{% if in_stock %}
								<a href="{{ path('app_event_tickets', {'slug': event.slug}) }}" class="inline-flex items-center justify-center gap-2 bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold px-5 py-3 transition-colors">Tickets <span aria-hidden="true">→</span></a>
							{% else %}<span class="font-semibold text-gray-500">{{ 'events.sold_out'|trans }}</span>{% endif %}
						</div>
					{% endfor %}
				</div>
			</section>
		{% else %}
			<section id="performance-dates" class="container mx-auto px-4 py-10 md:py-12 max-w-6xl">
				<h2 class="font-serif text-3xl text-[#34272a] mb-2">Voorstellingen</h2>
				<p class="text-gray-700">{{ 'events.no_events'|trans }}. {{ 'events.check_back_soon'|trans }}</p>
			</section>
		{% endif %}

		<section class="bg-[#fff1df] border-y border-[#eadfd1]">
			<div class="container mx-auto px-4 py-10 max-w-5xl">
				<p class="text-sm font-bold uppercase tracking-[.16em] text-red-800 mb-2">Goed om te weten</p>
				<h2 class="font-serif text-3xl text-[#34272a] mb-6">Praktische informatie</h2>
				<ul class="grid md:grid-cols-2 gap-x-10 gap-y-4 text-gray-800">
					<li><strong>Tickets:</strong> aangeschafte tickets kunnen niet worden geannuleerd, wel overgedragen.</li>
					<li><strong>Rolstoelplaatsen:</strong> inclusief begeleidersplaats telefonisch te reserveren; beperkt beschikbaar.</li>
					<li><strong>Groepen:</strong> vanaf 25 personen geldt groepskorting bij telefonische reservering.</li>
					<li><strong>Stoelen:</strong> plaatsen zijn niet reserveerbaar. Kom op tijd om samen te zitten.</li>
				</ul>
			</div>
		</section>
	</main>
{% endblock %}
