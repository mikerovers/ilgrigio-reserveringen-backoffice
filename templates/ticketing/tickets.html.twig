{% extends 'base.html.twig' %}

{% from 'components/macros.html.twig' import dutch_date %}

{% block title %}
	{{ event.name }}
	-
	{{ 'tickets.page_title'|trans }}
{% endblock %}

{% block body %}
	<header class="bg-[#c62828] text-white border-b-8 border-[#a91f24]">
		<div class="px-4 py-3 flex items-center justify-between gap-5 max-w-6xl mx-auto">
			<a href="{{ path('app_tickets') }}" aria-label="Jeugdcircus Il Grigio" class="shrink-0 flex items-center gap-3">
				<img src="{{ asset('images/Logo-IlGrigioClown.png') }}" alt="Jeugdcircus Il Grigio" class="h-10 md:h-12 w-auto">
				<span class="text-white font-bold tracking-wider md:text-base sm:text-sm">Jeugdcircus Il Grigio</span>
			</a>
			<a href="{{ path('app_tickets') }}" class="text-sm md:text-base text-white/90 hover:text-white transition-colors">
				<span aria-hidden="true">←</span> {{ 'tickets.back_to_events'|trans }}
			</a>
		</div>
	</header>

	<section class="bg-[#fffaf2] border-b border-[#eadfd1]">
		<div class="container mx-auto px-4 py-8 md:py-10 max-w-6xl">
			<p class="text-sm font-bold uppercase tracking-[.16em] text-red-700 mb-2">Jeugdcircus Il Grigio <span class="text-[#c89f75] px-1">/</span> Tickets</p>
			<h1 class="font-serif text-4xl md:text-5xl text-[#34272a]">{{ event.name }}</h1>
			<div class="flex flex-wrap gap-x-6 gap-y-2 text-gray-700 mt-4">
				<p><span class="text-red-800">●</span> {{ 'events.date'|trans }} {{ event.date ? dutch_date(event.date) : 'tickets.date_tbd'|trans }}{% if event.description|default('')|trim %} - {{ event.description }}{% endif %}</p>
				{% if event.doors_open %}<p><span class="text-red-800">●</span> {{ 'events.doors_open'|trans }} {{ event.doors_open }}</p>{% endif %}
				{% if event.time %}<p><span class="text-red-800">●</span> {{ 'events.show_start'|trans }} {{ event.time }} uur</p>{% endif %}
				{% if event.location %}<p><span class="text-red-800">●</span> {{ event.location }}</p>{% endif %}
			</div>
		</div>
	</section>

	<!-- Main Content -->
	<div class="bg-[#fffaf2] min-h-screen py-8 md:py-10">
		<div class="container mx-auto px-4">
			<form method="POST" action="{{ path('app_tickets_order', {'slug': event.slug}) }}" novalidate data-controller="frontend--ticket-selection" data-frontend--ticket-selection-ticket-types-value="{{ ticketTypes|json_encode|e('html_attr') }}" data-frontend--ticket-selection-event-permalink-value="{{ event.permalink }}" data-frontend--ticket-selection-max-tickets-per-order-value="{{ maxTicketsPerOrder }}" data-frontend--ticket-selection-tax-rate-value="{{ taxRate }}" data-frontend--ticket-selection-shared-stock-value="{{ sharedStock ?? 999 }}" data-action="submit->frontend--ticket-selection#validateForm">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('ticket_order') }}">
				<div
					class="flex flex-col lg:flex-row lg:items-start gap-8 max-w-6xl mx-auto">

					<!-- Left Column - Ticket Selection -->
					<div class="lg:w-2/3">
						<div
							class="bg-white border border-[#eadfd1] overflow-hidden">
							<!-- Header -->
							<div class="bg-[#dc2626] text-white px-6 py-4">
								<h2 class="text-xl font-bold flex items-center">
									<i class="fas fa-ticket-alt mr-2"></i>
									{{ 'tickets.select_tickets'|trans }}
								</h2>
							</div>

							<!-- Shared Stock Status Banner -->
							{% if stockStatus == 'outofstock' %}
								<div class="bg-red-100 border-b border-red-200 px-6 py-3">
									<div class="flex items-center text-red-800">
										<i class="fas fa-times-circle mr-2"></i>
										<span class="font-medium">{{ 'tickets.sold_out_label'|trans }}</span>
									</div>
								</div>
							{% elseif sharedStock and sharedStock < 10 %}
								<div class="bg-yellow-100 border-b border-yellow-200 px-6 py-3">
									<div class="flex items-center text-yellow-800">
										<i class="fas fa-exclamation-triangle mr-2"></i>
										<span class="font-medium">{{ 'tickets.only_left'|trans({'%count%': sharedStock}) }}</span>
									</div>
								</div>
							{% endif %}

							<!-- Validation Errors -->
							{% for message in app.flashes('error') %}
								<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
									<div class="flex items-center">
										<i class="fas fa-exclamation-triangle mr-2"></i>
										<span>{{ message }}</span>
									</div>
								</div>
							{% endfor %}

							<!-- Ticket Types -->
						<div class="p-6">
							{% if ticketTypes %}
								{% for ticketType in ticketTypes %}
									<div class="border border-[#eadfd1] mb-3 hover:border-[#d65a50] transition-colors {% if stockStatus == 'outofstock' %}opacity-60{% endif %}">
										<div class="p-4 md:p-5 flex flex-wrap sm:flex-nowrap items-center gap-3 md:gap-4">
											<!-- Ticket Name + Disabled Reason -->
											<div class="flex-1">
												<h3 class="text-lg font-semibold text-gray-800">{{ ticketType.name }}</h3>
												<p class="text-sm text-red-600 mt-1" data-row-error="{{ ticketType.id }}" role="alert"{% if rowErrors[ticketType.id] is not defined %} hidden{% endif %}>{{ rowErrors[ticketType.id]|default('') }}</p>
												{% if ticketType.disabled and ticketType.disabled_reason %}
													<div class="text-xs text-gray-600 mt-1">{{ ticketType.disabled_reason|sanitize_html('app.ticket_type_disabled_reason') }}</div>
												{% endif %}
											</div>

											{% if not ticketType.disabled %}
												<!-- Price -->
												{% if stockStatus != 'outofstock' %}
													{% if ticketType.price == '0' %}
													<span class="text-xl md:text-2xl font-bold text-red-700 whitespace-nowrap">{{ 'tickets.free'|trans }}</span>
													{% else %}
													<span class="text-xl md:text-2xl font-bold text-red-700 whitespace-nowrap">€{{ ticketType.price }}</span>
													{% endif %}
												{% endif %}

												<!-- Quantity Selector -->
												<div class="flex items-center shrink-0">
													{% if stockStatus == 'outofstock' %}
														<div class="text-sm font-medium text-gray-500 mr-4">{{ 'tickets.sold_out'|trans }}</div>
														<div class="flex items-center border border-gray-200 rounded-lg opacity-50">
															<button type="button" class="px-3 py-2 text-gray-400 rounded-l-lg cursor-not-allowed" disabled>
																<i class="fas fa-minus"></i>
															</button>
															<input type="number" id="quantity-{{ ticketType.id }}" class="w-16 text-center border-0 py-2 focus:ring-0 bg-gray-100 text-gray-400" value="0" min="0" max="0" data-ticket-id="{{ ticketType.id }}" data-price="{{ ticketType.price }}" data-frontend--ticket-selection-target="quantity" disabled>
															<button type="button" class="px-3 py-2 text-gray-400 rounded-r-lg cursor-not-allowed" disabled>
																<i class="fas fa-plus"></i>
															</button>
														</div>
													{% else %}
														<label class="text-sm font-medium text-gray-700 mr-4">{{ 'tickets.quantity'|trans }}:</label>
														<div class="flex items-center border border-gray-300 rounded-lg">
															<button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-l-lg" data-ticket-id="{{ ticketType.id }}" data-action="click->frontend--ticket-selection#decreaseQuantity">
																<i class="fas fa-minus"></i>
															</button>
															<input type="number" id="quantity-{{ ticketType.id }}" name="tickets[{{ ticketType.id }}][quantity]" class="w-16 text-center border-0 py-2 focus:ring-0" value="{% if existingQuantities[ticketType.id] is defined %}{{ existingQuantities[ticketType.id] }}{% elseif ticketType.type == 'baby' %}1{% elseif ticketType.type == 'minor' %}1{% else %}0{% endif %}" min="0" max="{{ sharedStock ?? 999 }}" data-ticket-id="{{ ticketType.id }}" data-price="{{ ticketType.price }}" data-frontend--ticket-selection-target="quantity" data-action="change->frontend--ticket-selection#quantityChanged" required{% if rowErrors[ticketType.id] is defined %} aria-invalid="true"{% endif %}>
															<!-- Hidden fields for ticket info -->
															<input type="hidden" name="tickets[{{ ticketType.id }}][id]" value="{{ ticketType.id }}">
															<input type="hidden" name="tickets[{{ ticketType.id }}][name]" value="{{ ticketType.name }}">
															<input type="hidden" name="tickets[{{ ticketType.id }}][price]" value="{{ ticketType.price }}">
															<button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-r-lg" data-ticket-id="{{ ticketType.id }}" data-action="click->frontend--ticket-selection#increaseQuantity">
																<i class="fas fa-plus"></i>
															</button>
														</div>
													{% endif %}
												</div>
											{% endif %}
										</div>
									</div>
								{% endfor %}
							{% else %}
								<div class="text-center py-8">
									<i class="fas fa-exclamation-triangle text-yellow-500 text-4xl mb-4"></i>
									<h3 class="text-xl font-semibold text-gray-800 mb-2">{{ 'tickets.no_ticket_types_available'|trans }}</h3>
									<p class="text-gray-600">{{ 'tickets.check_back_later'|trans }}</p>
								</div>
							{% endif %}
						</div>
						</div>
					</div>

					<!-- Right Column - Order Summary -->
					<div class="lg:w-1/3">
						<div
							class="bg-white border border-[#eadfd1] overflow-hidden lg:sticky lg:top-5">
							<!-- Header -->
							<div class="bg-[#dc2626] text-white px-6 py-4">
								<h3 class="text-lg font-bold flex items-center">
									<i class="fas fa-shopping-cart mr-2"></i>
									{{ 'tickets.order_summary'|trans }}
								</h3>
							</div>

							<!-- Order Items -->
							<div class="p-6">
								<div
									data-frontend--ticket-selection-target="orderItems" class="space-y-3 mb-6"><!-- Dynamic content will be added here -->
								</div>

								<!-- Coupon Section (Live Component: validated and priced on the server) -->
								{{ component('TicketSelection', {eventSlug: event.slug, appliedCouponCode: appliedCoupon.code ?? null}) }}

								<!-- Order Totals -->
								<div
									class="border-t pt-4">
									<!-- Subtotal -->
									<div class="flex justify-between items-center mb-2">
										<span class="text-gray-700">{{ 'tickets.subtotal'|trans }}</span>
										<span class="text-red-700" data-frontend--ticket-selection-target="subtotalPrice">€0.00</span>
									</div>

									<!-- Discount (hidden by default) -->
									<div data-frontend--ticket-selection-target="discountRow" class="flex justify-between items-center mb-2 hidden">
										<span class="text-green-600">{{ 'tickets.discount'|trans }}
											(<span data-frontend--ticket-selection-target="couponDescription"></span>)</span>
										<span class="text-green-600" data-frontend--ticket-selection-target="discountAmount">-€0.00</span>
									</div>

									<!-- Tax -->
									<div class="flex justify-between items-center mb-2 text-sm text-gray-600">
										<span>BTW ({{ taxRate }}%)</span>
										<span class="text-red-700" data-frontend--ticket-selection-target="taxAmount">€0.00</span>
									</div>

									<!-- Total -->
									<div class="flex justify-between items-center text-lg font-semibold border-t border-gray-200 pt-2">
										<span>{{ 'tickets.total'|trans }}
											(incl. BTW) (<span data-frontend--ticket-selection-target="totalTickets">2</span>
											{{ 'tickets.total_tickets'|trans }})</span>
										<span class="text-red-700" data-frontend--ticket-selection-target="totalPrice">€25</span>
									</div>

									<!-- Maximum tickets warning -->
									<div data-frontend--ticket-selection-target="maxTicketsWarning" class="text-xs text-gray-500 mt-2 p-2 bg-gray-50 rounded hidden" role="status" aria-live="polite">
										<i class="fas fa-info-circle mr-1"></i>
										Maximum
										{{ maxTicketsPerOrder }}
										tickets per bestelling. Groepen vanaf {{ maxTicketsPerOrder }} personen kunnen in aanmerking komen voor korting mits zij van tevoren gereserveerd hebben. Voor informatie over groepskortingen ontvangen wij graag een e-mail (info@ilgrigio.nl).
									</div>
								</div>

								<!-- Proceed Button -->
								<button type="submit" data-frontend--ticket-selection-target="proceedButton" class="w-full bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold py-3 px-4 mt-6 transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed" disabled>
									{{ 'tickets.proceed_to_checkout'|trans }}
								</button>

								<!-- Hidden form fields for validation -->
								<input type="hidden" name="event_id" value="{{ event.id }}">
								<input
								type="hidden" name="discount_amount" data-frontend--ticket-selection-target="discountAmountField" value="0">

								<!-- Error display -->
								<div data-frontend--ticket-selection-target="errorContainer" class="mt-4 hidden">
									<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded" role="alert">
										<strong class="font-bold">{{ 'tickets.validation_error'|trans }}</strong>
										<span data-frontend--ticket-selection-target="errorMessage" class="block sm:inline"></span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>

	{% endblock %}
