{% extends 'register/base.html.twig' %}

{#
    Authenticated register layout: red masthead (same as the scanner), page
    content and a footer. Variables: operator.
#}

{% block page %}
    <header class="shrink-0 bg-[#c62828] border-b-[6px] border-[#a91f24] text-white pt-[env(safe-area-inset-top)]">
        <div class="mx-auto max-w-6xl px-4 py-2 flex flex-wrap items-center gap-x-4 gap-y-2">
            <a href="{{ path('register_index') }}" class="flex items-center gap-4 min-w-0 shrink-0">
                <img src="{{ asset('images/Logo-IlGrigioClown.png') }}" alt="Jeugdcircus Il Grigio" class="h-9 w-auto">
                <span class="hidden sm:block h-8 w-px bg-white/30"></span>
                <span class="text-lg font-semibold">Kassa</span>
            </a>

            <div class="ml-auto flex flex-wrap items-center gap-3">
                {% block header_actions %}{% endblock %}

                <span class="flex items-center gap-2 text-base max-md:hidden">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M2.5 14c.6-2.6 2.8-4 5.5-4s4.9 1.4 5.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    {{ operator }}
                </span>
                <a href="{{ path('register_logout') }}" data-turbo="false" class="shrink-0 text-base underline underline-offset-4 hover:text-amber-200 max-md:py-2">Uitloggen</a>
            </div>
        </div>
    </header>

    {% set menu = [
        {route: 'register_index', label: 'Kassa', icon: 'M3 4h2l1.5 8h8L17 6H6M8 16.5a.5.5 0 1 0 0 .01M14 16.5a.5.5 0 1 0 0 .01'},
        {route: 'register_orders', label: 'Bestellingen', icon: 'M5 3h10v14l-2-1.5L11 17l-2-1.5L7 17l-2-1.5zM8 7h4M8 10h4'},
        {route: 'register_coupons', label: 'Kortingscodes', icon: 'M3 8V5h14v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4zM12 7l-4 6'},
    ] %}
    <nav aria-label="Hoofdmenu" class="shrink-0 border-b border-[#eadfd1] bg-[#fbeedd]">
        <ul class="mx-auto max-w-6xl px-2 sm:px-4 flex">
            {% for item in menu %}
                {% set active = app.current_route == item.route %}
                <li class="flex-1 sm:flex-none">
                    <a href="{{ path(item.route) }}"
                       {% if active %}aria-current="page"{% endif %}
                       class="flex min-h-12 items-center justify-center gap-2 border-b-4 px-4 text-base font-semibold sm:justify-start sm:px-6
                              {{ active ? 'border-[#c62828] bg-white text-[#c62828]' : 'border-transparent text-gray-700 hover:bg-white/60 hover:text-[#c62828]' }}
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#c62828]">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="{{ item.icon }}"/>
                        </svg>
                        <span class="max-[380px]:hidden">{{ item.label }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>

    {% block content %}{% endblock %}

    <footer class="mt-auto shrink-0 border-t border-[#eadfd1] bg-[#fbeedd] text-sm text-gray-600">
        <div class="mx-auto max-w-6xl px-4 py-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
            {% block footer %}{% endblock %}
        </div>
    </footer>
{% endblock %}
