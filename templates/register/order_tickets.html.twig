<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Tickets {{ order.orderNumber }}</title>
    <style>
        /* Print sheet: millimetre units so the page maths below is exact. A4 portrait with 12mm
           margins leaves 186mm x 273mm. A ticket cell is an inline-block (an atomic box that the
           browser never splits across pages) and also carries break-inside: avoid, so a QR code
           can never be cut in half; cells simply flow on to the next page. */
        @page { size: A4 portrait; margin: 12mm; }
        * { box-sizing: border-box; }
        html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        body { margin: 0; font-family: Roboto, Arial, Helvetica, sans-serif; font-size: 11pt; color: #222; background: #fff; }
        .sheet { max-width: 186mm; margin: 0 auto; padding: 8mm 0; }

        .toolbar { display: flex; gap: 8px; justify-content: flex-end; margin-bottom: 8mm; font-size: 14px; }
        .toolbar button { height: 40px; padding: 0 18px; border: 0; background: #c62828; color: #fff; font-weight: 600; cursor: pointer; }
        .toolbar button.secondary { background: #eee; color: #222; }

        header.title { text-align: center; margin-bottom: 6mm; break-inside: avoid; }
        header.title h1 { margin: 0; font-size: 22pt; }
        header.title p { margin: 1mm 0 0; font-size: 15pt; }

        .summary { display: flex; gap: 6mm; align-items: flex-start; padding-bottom: 5mm; border-bottom: 1px solid #ddd; break-inside: avoid; }
        .meta { flex: 0 0 62mm; padding-right: 5mm; border-right: 1px solid #ddd; line-height: 1.6; font-size: 10pt; }
        .meta strong { font-weight: 700; }
        .meta .name { color: #c62828; }
        table.lines { flex: 1; border-collapse: collapse; font-size: 10pt; }
        table.lines th { text-align: left; padding: 1.5mm 2mm; }
        table.lines td { padding: 1.5mm 2mm; }
        table.lines th:last-child, table.lines td:last-child { text-align: right; white-space: nowrap; }
        table.lines tr.shade td { background: #ddd; }
        table.lines tr { break-inside: avoid; }

        .tickets { margin-top: 5mm; font-size: 0; /* removes the gap between inline-blocks */ }
        /* 3 columns x 4 rows = 12 tickets per A4 page. The label never clips: the name may use up to
           three lines and the long ticket code breaks anywhere, and the cell is tall enough for both. */
        .ticket { display: inline-block; vertical-align: top; width: 62mm; height: 66mm; padding: 2mm 3mm; margin: 0; font-size: 9pt;
                  break-inside: avoid; page-break-inside: avoid; overflow: hidden; }
        .ticket .label { display: block; min-height: 17mm; line-height: 1.3; }
        .ticket .name { display: block; font-weight: 600; overflow-wrap: anywhere; }
        .ticket .code { display: block; margin-top: .5mm; font-family: "Courier New", monospace; font-size: 8pt; overflow-wrap: anywhere; word-break: break-all; }
        .ticket img { display: block; width: 42mm; height: 42mm; margin: 1mm auto 0; }

        .empty { margin-top: 10mm; text-align: center; font-size: 12pt; color: #555; }

        @media print {
            .toolbar { display: none; }
            .sheet { padding: 0; max-width: none; }
        }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="toolbar">
            <button type="button" onclick="window.print()">Afdrukken</button>
            <button type="button" class="secondary" onclick="window.close()">Sluiten</button>
        </div>

        <header class="title">
            <h1>Jeugdcircus Il Grigio</h1>
            {% if event_name %}<p>{{ event_name }}{% if event_date %} · {{ event_date }}{% endif %}</p>{% endif %}
        </header>

        <section class="summary">
            <div class="meta">
                <div>Naam: <strong class="name">{{ (order.billing.firstName ~ ' ' ~ order.billing.lastName)|trim ?: (order.customer.firstName ~ ' ' ~ order.customer.lastName) }}</strong></div>
                <div>Bestelnummer: <strong>{{ order.orderNumber }}</strong></div>
                <div>Notitie: {{ order.note }}</div>
                <div>Datum: <strong>{{ order.createdAt|date('d-m-Y H:i:s') }}</strong></div>
            </div>
            <table class="lines">
                <thead>
                    <tr><th>Naam</th><th>Aantal tickets</th><th>Prijs</th></tr>
                </thead>
                <tbody>
                    {% for line in lines %}
                        <tr><td>{{ line.name }}</td><td>{{ line.quantity }}</td><td>{{ line.price }}</td></tr>
                    {% endfor %}
                    {% if discount %}
                        <tr class="shade"><td>Korting</td><td></td><td>− {{ discount }}</td></tr>
                    {% endif %}
                    <tr class="shade"><td>{{ order.taxLabel }}</td><td></td><td>{{ tax }}</td></tr>
                    <tr class="shade"><td>Totaal</td><td>{{ ticket_count }}</td><td>{{ total }}</td></tr>
                </tbody>
            </table>
        </section>

        {% if tickets %}
            <section class="tickets" aria-label="Tickets">
                {% for ticket in tickets %}
                    <div class="ticket">
                        <span class="label">
                            <span class="name">#{{ ticket.number }}: {{ ticket.name }}</span>
                            <span class="code">{{ ticket.code }}</span>
                        </span>
                        <img src="{{ ticket.qr }}" alt="QR-code {{ ticket.code }}">
                    </div>
                {% endfor %}
            </section>
        {% else %}
            <p class="empty">Voor deze bestelling zijn geen geldige tickets beschikbaar.</p>
        {% endif %}
    </div>

    {% if tickets %}
        <script>
            // Open the print dialog once the QR images have loaded.
            window.addEventListener('load', function () { window.print(); });
        </script>
    {% endif %}
</body>
</html>
