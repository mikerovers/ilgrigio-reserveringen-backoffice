{% extends 'base.html.twig' %}

{% block body %}
	<header class="bg-[#c62828] text-white border-b-8 border-[#a91f24]">
		<div class="px-4 py-3 flex items-center justify-between gap-6 max-w-6xl mx-auto">
			<a href="{{ path('app_tickets') }}" aria-label="Jeugdcircus Il Grigio" class="shrink-0 flex items-center gap-3">
				<img src="{{ asset('images/Logo-IlGrigioClown.png') }}" alt="Jeugdcircus Il Grigio" class="h-10 md:h-12 w-auto">
				<span class="text-white font-bold tracking-wider md:text-base sm:text-sm">Jeugdcircus Il Grigio</span>
			</a>
			{% include 'customer/_header_link.html.twig' %}
		</div>
	</header>
	<section class="bg-[#fffaf2] min-h-[70vh] px-4 py-8 md:py-12">
		<div class="max-w-2xl mx-auto bg-white border border-[#eadfd1] shadow-lg p-6 md:p-10">
			{% block content %}{% endblock %}
		</div>
	</section>
{% endblock %}
