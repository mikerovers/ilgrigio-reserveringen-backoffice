{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block main %}
<div class="container-fluid px-0 py-4">
    <div class="card shadow-sm">
        <div class="card-header fw-semibold">Verkochte tickets per jaar</div>
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Jaar</th>
                        <th class="text-end">Tickets verkocht</th>
                    </tr>
                </thead>
                <tbody>
                    {% for year, total in totals_by_year %}
                        <tr>
                            <td>{{ year }}</td>
                            <td class="text-end">{{ total }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-muted">Nog geen tickets verkocht.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
