<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <title>{% block title %}Il Grigio Reserveringen{% endblock %}</title>
        
        <!-- Favicon -->
        <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon.ico') }}">
        
        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                plugins: [
                    function({ addBase }) {
                        addBase({ 'a, button': { cursor: 'pointer' } });
                    }
                ]
            }
        </script>

        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        <!-- iOS Safari ignores user-scalable=no; touch-action disables double-tap zoom -->
        <style>
            html {
                touch-action: manipulation;
                -webkit-text-size-adjust: 100%;
                scroll-behavior: smooth;
            }

            @media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }
            }
        </style>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-gray-50 min-h-screen">
        <!-- Main Content -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Algemene Voorwaarden Modal -->
        <div id="termsModal" class="fixed inset-0 z-50 flex items-center justify-center hidden" aria-modal="true" role="dialog" data-controller="frontend--modal" data-frontend--modal-id-value="terms">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-black bg-opacity-60" data-action="click->frontend--modal#close"></div>
            <!-- Modal panel -->
            <div class="relative bg-white rounded-lg shadow-xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col">
                <!-- Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                    <h2 class="text-xl font-bold text-gray-800">Algemene Voorwaarden</h2>
                    <button type="button" data-action="click->frontend--modal#close" class="text-gray-400 hover:text-gray-600 transition-colors" aria-label="Sluiten">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <!-- Body -->
                <div class="overflow-y-auto px-6 py-6 text-gray-700 leading-relaxed text-sm space-y-4">
                    <h3 class="text-lg font-semibold text-gray-800">Algemene voorwaarden JeugdCircus Il Grigio</h3>
                    <p>
                        Jeugdcircus Il Grigio gebruikt Mollie voor de verwerking van alle online transacties.
                        Uw persoonsgegevens worden in dit kader gedeeld met Mollie en aan haar gelieerde ondernemingen.
                        Wanneer u via onze website uw kaarten reserveert, dan geeft u, direct of indirect, toestemming
                        aan Jeugdcircus Il Grigio, Mollie en aan haar gelieerde ondernemingen, alle vereiste
                        (uitdrukkelijke) toestemmingen als bedoeld in de toepasselijke gegevensbeschermingswetgeving
                        te verwerken.
                    </p>
                </div>
                <!-- Footer -->
                <div class="px-6 py-4 border-t border-gray-200 text-right">
                    <button type="button" data-action="click->frontend--modal#close" class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-5 rounded-lg transition duration-300">
                        Sluiten
                    </button>
                </div>
            </div>
        </div>

        <!-- Disable pinch-zoom on iOS Safari, which ignores the viewport scale settings -->
        <script>
            document.addEventListener('gesturestart', function (e) { e.preventDefault(); });
            document.addEventListener('gesturechange', function (e) { e.preventDefault(); });
            document.addEventListener('gestureend', function (e) { e.preventDefault(); });
        </script>

        <!-- Footer -->
        <footer class="bg-[#c62828] text-white border-t-8 border-[#a91f24]">
            <div class="container mx-auto px-5 py-10 md:py-12 max-w-6xl grid gap-8 md:grid-cols-[1fr_1.5fr_auto] md:items-center">
                <a href="http://ilgrigio.nl" target="_blank" aria-label="Jeugdcircus Il Grigio" class="flex flex-col items-center md:items-start">
                    <img src="{{ asset('images/Logo-IlGrigioClown.png') }}" alt="Jeugdcircus Il Grigio" class="h-16 w-auto mb-3">
                    <span class="font-serif text-xl">Jeugdcircus Il Grigio</span>
                </a>

                <div class="text-sm leading-7 text-white text-center md:text-left">
                    <p class="font-semibold text-white">Stichting Haarens Jeugdcircus Il Grigio</p>
                    <p>E-mail: <a href="mailto:info@ilgrigio.nl" class="text-amber-200 underline underline-offset-4 hover:text-white">info@ilgrigio.nl</a></p>
                    <p>BTW: NL006137155B01 <span class="px-1 text-red-400">·</span> KvK: 41081727</p>
                    <p>Website: <a href="http://www.ilgrigio.nl" target="_blank" class="text-amber-200 underline underline-offset-4 hover:text-white">www.ilgrigio.nl</a></p>
                    <button type="button" class="js-open-modal text-amber-200 underline underline-offset-4 hover:text-white bg-transparent border-none cursor-pointer text-sm p-0" data-modal-open="terms">Algemene voorwaarden</button>
                </div>

                <a href="http://ilgrigio.nl" target="_blank" class="justify-self-center md:justify-self-end inline-flex items-center gap-2 bg-white hover:bg-amber-50 text-[#a91f24] font-bold px-5 py-3 transition-colors">
                    Naar de circuswebsite <span aria-hidden="true">→</span>
                </a>
            </div>
        </footer>
    </body>
</html>
