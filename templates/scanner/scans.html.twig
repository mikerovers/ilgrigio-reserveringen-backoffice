{% extends 'scanner/layout.html.twig' %}

{% set screen = 'scans' %}

{% block title %}Alle scans{% endblock %}

{% block body_attrs %}
    {%- if event -%}
        data-controller="scanner--clock scanner--order-modal"
        data-scanner--order-modal-url-value="{{ path('scanner_order', {id: event.id, orderNumber: '__ORDER__'}) }}"
        data-scanner--order-modal-can-scan-value="false"
    {%- else -%}
        data-controller="scanner--clock"
    {%- endif -%}
{% endblock %}

{% block content %}
    <main class="flex-1 px-4 py-6">
        <div class="mx-auto max-w-6xl">
            <section class="border border-[#eadfd1] bg-white" aria-labelledby="all-scans-title">
                <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[#eadfd1] px-6 pb-4 pt-5">
                    <div>
                        <h1 id="all-scans-title" class="font-serif text-3xl">Alle scans</h1>
                        <p class="mt-1 text-base text-gray-600">
                            {% if event %}
                                {{ total }} {{ total == 1 ? 'scan' : 'scans' }} door {{ operator }}
                                · {{ event.name }} · {{ info.day }} {{ info.starts }}
                            {% else %}
                                Geen voorstelling geselecteerd
                            {% endif %}
                        </p>
                    </div>
                    {% if event %}
                        <a href="{{ path('scanner_index', {event: event.id}) }}" class="border border-[#d6c4b1] px-4 py-2 font-semibold hover:bg-[#fffaf2]">Terug naar scannen</a>
                    {% endif %}
                </div>

                {% if tickets is empty %}
                    <p class="px-6 py-10 text-center text-gray-600">Nog geen scans van deze balie bij deze voorstelling.</p>
                {% else %}
                    <ul class="divide-y divide-[#eadfd1] px-6">
                        {% for ticket in tickets %}
                            <li>
                            <button type="button" class="flex w-full items-center gap-4 py-4 text-left hover:bg-[#fffaf2] focus:outline-none focus:ring-2 focus:ring-[#c62828]"
                                    aria-label="Order {{ ticket.order.orderNumber }} bekijken"
                                    data-action="click->scanner--order-modal#openFromRow" data-order-number="{{ ticket.order.orderNumber }}">
                                <span class="w-14 shrink-0 font-mono text-base text-gray-700">{{ ticket.checkedInAt|date('H:i') }}</span>
                                <span class="min-w-0 flex-1 truncate text-base text-gray-700">
                                    {{ ticket.ticketType.name }} · {{ ticket.order.orderNumber }}
                                    <span class="hidden font-mono text-sm text-gray-400 sm:inline">· {{ ticket.ticketCode }}</span>
                                </span>
                                <span class="shrink-0 border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-emerald-900">Toegelaten</span>
                            </button>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if pages > 1 %}
                    <nav class="flex items-center justify-between border-t border-[#eadfd1] p-6" aria-label="Paginering">
                        {% if page > 1 %}
                            <a class="border border-[#d6c4b1] px-4 py-2 font-semibold hover:bg-[#fffaf2]" href="{{ path('scanner_scans', {event: event.id, page: page - 1}) }}">← Vorige</a>
                        {% else %}<span></span>{% endif %}
                        <span class="text-gray-600">Pagina {{ page }} van {{ pages }}</span>
                        {% if page < pages %}
                            <a class="border border-[#d6c4b1] px-4 py-2 font-semibold hover:bg-[#fffaf2]" href="{{ path('scanner_scans', {event: event.id, page: page + 1}) }}">Volgende →</a>
                        {% else %}<span></span>{% endif %}
                    </nav>
                {% endif %}
            </section>
        </div>
    </main>

    {% if event %}
        {% include 'scanner/_order_modal.html.twig' %}
    {% endif %}
{% endblock %}
