{% autoescape false %}
// Scanbalie service worker. Network only: nothing is cached, so counters, scans
// and logins are always live. A failed page navigation shows an offline notice.
self.addEventListener('install', () => self.skipWaiting());
self.addEventListener('activate', (event) => event.waitUntil(self.clients.claim()));

const OFFLINE_PAGE = `<!DOCTYPE html><html lang="nl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Geen verbinding</title>
<style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;
background:#fffaf2;color:#34272a;font-family:system-ui,sans-serif;text-align:center}
h1{font-size:1.5rem}button{background:#c62828;color:#fff;border:0;padding:.75rem 1.5rem;font-size:1rem;cursor:pointer}</style>
</head><body><div><h1>Geen verbinding</h1><p>De scanbalie heeft internet nodig. Controleer de verbinding.</p>
<button onclick="location.reload()">Opnieuw proberen</button></div></body></html>`;

self.addEventListener('fetch', (event) => {
    if (event.request.mode !== 'navigate') {
        return;
    }
    event.respondWith(
        fetch(event.request).catch(() => new Response(OFFLINE_PAGE, {
            status: 503,
            headers: { 'Content-Type': 'text/html; charset=UTF-8' },
        })),
    );
});
{% endautoescape %}
