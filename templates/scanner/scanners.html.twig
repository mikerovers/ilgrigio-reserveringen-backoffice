{% extends 'scanner/layout.html.twig' %}

{% set screen = 'setup' %}

{% block title %}Scanner instellen{% endblock %}

{% block content %}
    <main class="flex-1 px-4 py-6">
        <style>
            .scanner-barcode svg { shape-rendering: crispEdges; display: block; }
            @media print {
                header, footer, .scanner-no-print { display: none !important; }
                html, body { background: #fff !important; }
                main { padding: 0 !important; }
                .scanner-card {
                    border: 0 !important;
                    break-after: page;
                    page-break-after: always;
                }
                .scanner-card:last-child {
                    break-after: auto;
                    page-break-after: auto;
                }
            }
        </style>

        <div class="mx-auto max-w-4xl space-y-6">
            <section class="border border-[#eadfd1] bg-white p-6" aria-labelledby="setup-title">
                <div>
                    <h1 id="setup-title" class="font-serif text-3xl">Scanner instellen</h1>
                    <p class="mt-2 max-w-2xl text-base text-gray-700">
                        Scan deze codes om de USB-scanner te programmeren. De scanner moet elke
                        kaartscan met <strong>Enter</strong> afsluiten.
                    </p>
                </div>

                {% if scannerTypes is empty %}
                    <p class="mt-6 border-t border-[#eadfd1] pt-4 text-base text-gray-600">
                        Er zijn nog geen scannerconfiguraties. Voeg ze toe in het backoffice.
                    </p>
                {% else %}
                    <div class="mt-5 flex flex-wrap items-center justify-center gap-3 border-t border-[#eadfd1] pt-4">
                        <label for="scanner-type" class="block text-sm font-semibold text-gray-700">
                            Scannermodel
                        </label>
                        <select id="scanner-type" onchange="Turbo.visit(this.value)"
                                class="h-11 min-w-[16rem] border border-[#d6c4b1] bg-white px-3 pr-8 text-base focus:outline-none focus:ring-2 focus:ring-[#c62828]">
                            {% for candidate in scannerTypes %}
                                {% set query = {type: candidate.slug}|merge(event ? {event: event.id} : {}) %}
                                <option value="{{ path('scanner_setup', query) }}" {{ scannerType and candidate.id == scannerType.id ? 'selected' }}>
                                    {{ candidate.name }}{% if candidate.manufacturer %} · {{ candidate.manufacturer }}{% endif %}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {% if scannerType and scannerType.notes %}
                        <div class="mt-4 border-l-4 border-[#c62828] bg-[#fffaf2] px-4 py-3 text-base text-gray-700">
                            {{ scannerType.notes|e|nl2br }}
                        </div>
                    {% endif %}
                {% endif %}
            </section>

            {% if barcodes is empty and scannerTypes is not empty %}
                <p class="border border-[#eadfd1] bg-white p-6 text-center text-base text-gray-600">
                    Nog geen actieve barcodes voor dit scannermodel. Voeg ze toe in het backoffice.
                </p>
            {% endif %}

            {% if barcodes is not empty %}
                <ol class="space-y-6">
                    {% for item in barcodes %}
                        <li class="scanner-card border border-[#eadfd1] bg-white p-6">
                            <div class="flex items-baseline gap-3">
                                <span class="font-stopbuck text-2xl text-[#c62828]">{{ loop.index }}</span>
                                <h2 class="text-xl font-semibold">{{ item.barcode.label }}</h2>
                            </div>
                            {% if item.barcode.description %}
                                <p class="mt-1 text-base text-gray-600">{{ item.barcode.description }}</p>
                            {% endif %}

                            {% if item.svg %}
                                <div class="scanner-barcode mt-4 overflow-x-auto bg-white px-[30px] py-4">
                                    {{ item.svg|raw }}
                                </div>
                            {% else %}
                                <p class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-base text-red-900">
                                    Deze barcode kan niet worden weergegeven. Controleer de payload in het backoffice.
                                </p>
                            {% endif %}

                            <p class="mt-4 font-mono text-sm text-gray-500">Payload: {{ item.payload }}</p>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </div>
    </main>
{% endblock %}

{% block footer_center %}
    <p class="hidden md:block"><kbd class="border border-[#d6c4b1] bg-white px-2 py-0.5 text-xs font-bold">F4</kbd> Scanner instellen</p>
{% endblock %}
