FROM php:8.4.27-fpm-alpine

RUN apk add --no-cache \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    libxslt-dev \
    libpq-dev \
    gcompat \
    libstdc++ \
    nginx \
    supervisor \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd intl xsl bcmath pdo_pgsql

# New Relic PHP agent (musl build). Ships logs/APM in the background via its daemon,
# configured at runtime from NEW_RELIC_LICENSE_KEY / NEW_RELIC_APP_NAME.
# Leave NEW_RELIC_AGENT_VERSION empty to use the latest release, or pin e.g. 11.x.y.z.
ARG NEW_RELIC_AGENT_VERSION=""
COPY docker/newrelic.ini /tmp/newrelic-overrides.ini
RUN cd /tmp \
    && NR_VERSION="${NEW_RELIC_AGENT_VERSION:-$(curl -fsS https://download.newrelic.com/php_agent/release/ | grep -o '[1-9][0-9]\?\(\.[0-9]\+\)\{3\}' | head -n1)}" \
    && curl -fsSo newrelic-php-agent.tar.gz "https://download.newrelic.com/php_agent/release/newrelic-php5-${NR_VERSION}-linux-musl.tar.gz" \
    && tar xzf newrelic-php-agent.tar.gz \
    && NR_INSTALL_USE_CP_NOT_LN=1 NR_INSTALL_SILENT=1 NR_INSTALL_KEY=0000000000000000000000000000000000000000 ./newrelic-php5-*/newrelic-install install \
    && sed -i 's/^[ ;]*newrelic.license[[:space:]]*=.*/newrelic.license = "${NEW_RELIC_LICENSE_KEY}"/' "$(php-config --ini-dir)/newrelic.ini" \
    && sed -i 's/^[ ;]*newrelic.appname[[:space:]]*=.*/newrelic.appname = "${NEW_RELIC_APP_NAME}"/' "$(php-config --ini-dir)/newrelic.ini" \
    && cat /tmp/newrelic-overrides.ini >> "$(php-config --ini-dir)/newrelic.ini" \
    && rm -rf /tmp/newrelic-php-agent.tar.gz /tmp/newrelic-php5-* /tmp/newrelic-overrides.ini

# PHP-FPM must pass the container environment to workers so the agent sees NEW_RELIC_* vars
RUN printf '%s\n' '[www]' 'clear_env = no' > /usr/local/etc/php-fpm.d/zz-clear-env.conf

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    APP_ENV=prod

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-scripts --no-interaction

COPY . .

# Provide an empty .env so Symfony runtime dotenv loading does not error in prod
# (real config comes from the runtime environment; .env is gitignored/dockerignored).
RUN touch .env

RUN composer dump-autoload --no-dev --optimize

# Copy and setup entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Configure nginx
RUN printf '%s\n' \
    'user www-data;' \
    'worker_processes auto;' \
    'pid /run/nginx/nginx.pid;' \
    '' \
    'events {' \
    '    worker_connections 1024;' \
    '}' \
    '' \
    'http {' \
    '    include /etc/nginx/mime.types;' \
    '    default_type application/octet-stream;' \
    '' \
    '    access_log /var/log/nginx/access.log;' \
    '    error_log /var/log/nginx/error.log;' \
    '' \
    '    sendfile on;' \
    '    tcp_nopush on;' \
    '    tcp_nodelay on;' \
    '    keepalive_timeout 65;' \
    '    types_hash_max_size 2048;' \
    '' \
    '    gzip on;' \
    '    gzip_vary on;' \
    '    gzip_proxied any;' \
    '    gzip_comp_level 6;' \
    '    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;' \
    '' \
    '    server {' \
    '        listen 8080;' \
    '        server_name _;' \
    '        root /app/public;' \
    '' \
    '        location / {' \
    '            try_files $uri /index.php$is_args$args;' \
    '        }' \
    '' \
    '        location ~ ^/index\.php(/|$) {' \
    '            fastcgi_pass 127.0.0.1:9000;' \
    '            fastcgi_split_path_info ^(.+\.php)(/.*)$;' \
    '            include fastcgi_params;' \
    '            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;' \
    '            fastcgi_param DOCUMENT_ROOT $realpath_root;' \
    '            internal;' \
    '        }' \
    '' \
    '        location ~ \.php$ {' \
    '            return 404;' \
    '        }' \
    '    }' \
    '}' \
    > /etc/nginx/nginx.conf

# Configure supervisor
RUN mkdir -p /etc/supervisor/conf.d && \
    printf '%s\n' \
    '[supervisord]' \
    'nodaemon=true' \
    'user=root' \
    'logfile=/var/log/supervisor/supervisord.log' \
    'pidfile=/var/run/supervisord.pid' \
    '' \
    '[program:php-fpm]' \
    'command=php-fpm --nodaemonize' \
    'stdout_logfile=/dev/stdout' \
    'stdout_logfile_maxbytes=0' \
    'stderr_logfile=/dev/stderr' \
    'stderr_logfile_maxbytes=0' \
    'autorestart=true' \
    'startretries=3' \
    '' \
    '[program:nginx]' \
    'command=nginx -g '\''daemon off;'\''' \
    'stdout_logfile=/dev/stdout' \
    'stdout_logfile_maxbytes=0' \
    'stderr_logfile=/dev/stderr' \
    'stderr_logfile_maxbytes=0' \
    'autorestart=true' \
    'startretries=3' \
    > /etc/supervisor/conf.d/supervisord.conf

# Create necessary directories and set permissions
RUN mkdir -p /var/log/supervisor /run/nginx /app/var/cache /app/var/log \
    && chown -R www-data:www-data /app/var

EXPOSE 8080

CMD ["docker-entrypoint.sh"]
